<?xml version="1.0" encoding="utf-8"?>
<!--
  The Squeeze mark: two arcs closing on a waist, crossed by a measurement line.

  Vector rather than density-specific PNGs — minSdk 26 means mipmap-anydpi-v26 covers every
  supported device, so one file is the whole icon at every size.

  Geometry sits inside the 66dp safe zone of the 108dp adaptive canvas, so no part of the
  mark is clipped by a circular, squircle or rounded mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left arc, bowing in to the waist at the vertical midpoint. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,26 C38,42 48,45 48,54 C48,63 38,66 38,82" />

    <!-- Right arc, mirrored. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M70,26 C70,42 60,45 60,54 C60,63 70,66 70,82" />

    <!-- The reading being taken, through the narrowest point. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30,54 L78,54" />
</vector>
