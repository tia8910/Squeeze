<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground. Drawn as a vector so the app needs no density-specific PNGs;
     minSdk is 26, so mipmap-anydpi-v26 covers every supported device.

     The mark is a caliper closing on a form: the measurement the app is built around. -->
