<?xml version="1.0" encoding="utf-8"?>
<!--
  The Squeeze.fit figure, white, on the blue tile.

  The path is the brand sheet's own SVG, shared verbatim with SqueezeLogo.kt — if one
  changes, change both. It is authored in a 200x200 space, so the group scales it into the
  adaptive icon's 108x108 viewport. At 0.33 the figure occupies about 50x49 units centred on
  54,54, keeping its arms and legs inside the 66-unit safe circle a fully circular launcher
  mask crops to.

  No squeeze bands here: they are white, and on a white figure they would disappear. The
  brand sheet's own icon tile drops them for the same reason.

  Vector rather than density-specific PNGs — minSdk 26 means mipmap-anydpi-v26 covers every
  supported device, so one file is the whole icon at every size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.33"
        android:scaleY="0.33"
        android:translateX="21"
        android:translateY="21">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M100 28c-15 0-26 11-26 25 0 10 6 19 15 23-7 3-13 8-17 15l-10 18c-8 13-20 24-35 31l12 18c19-8 35-22 46-39l7-12v31l-22 23 17 13 13-13 13 13 17-13-22-23v-31l7 12c11 17 27 31 46 39l12-18c-15-7-27-18-35-31l-10-18c-4-7-10-12-17-15 9-4 15-13 15-23 0-14-11-25-26-25z" />
    </group>
</vector>
