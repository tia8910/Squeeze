    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,32c5.6,0 10,4.2 10,9.4c0,3.4 -1.6,6.2 -3.2,8.8c-1.4,2.4 -2.4,4.4 -2.4,7.2l0,14.2c0,3.4 -1.8,5.4 -4.4,5.4c-2.6,0 -4.4,-2 -4.4,-5.4l0,-14.2c0,-2.8 -1,-4.8 -2.4,-7.2c-1.6,-2.6 -3.2,-5.4 -3.2,-8.8C44,36.2 48.4,32 54,32z" />

    <!-- Caliper arms closing on the form from both sides. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,40l4,0l0,28l-4,0z" />
    <path
        android:fillColor="#FFFFFF"
