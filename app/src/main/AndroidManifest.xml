<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET exists for one feature: Google Drive backup, which the user turns on by
      signing in with Google. Until they do, the app opens no connection at all.

      What that permission does and does not change:
        - Photographs never leave the device. Backup sends only the JSON written by
          BackupCodec, which drops every photo reference; there is no code path that uploads
          an image, and ScanPhotoStore keeps photos in encrypted app-private storage.
        - The backup goes to the user's own Drive, in the hidden app-data folder that only
          this app can read (scope drive.appdata, nothing else in their Drive), over TLS.
        - Body scanning, the CLIP model and every other analysis remain on-device.
        - Health Connect and Play Billing still work over IPC, not this process's network.

      Before this, the app had no INTERNET permission at all and the OS enforced "nothing
      leaves". Anything else that seems to need the network is still a design question
      first: keep it out of the photo path.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Photo capture for body scanning. Optional so the app still installs on devices
         without a camera, where uploading photos and tape entry both remain available. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Play Billing merges com.android.vending.BILLING in from the library manifest. -->

    <application
        android:name=".SqueezeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Squeeze"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Squeeze"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
