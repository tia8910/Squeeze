// Cloudflare deployment of the squeeze.fit website: static files only, no code runs.
// site/ is generated by `node web/build.ts`; CI fails if it is out of date.
{
  "name": "squeeze-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
